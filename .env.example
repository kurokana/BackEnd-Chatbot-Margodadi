APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chatbot_margodadi
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# RAG LLM & Chatbot Python Service Config
# ==========================================
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/chatbot
RAG_TOP_K=3
UPLOAD_DIR=./uploads

# Konfigurasi LLM API (Google Gemini / OpenAI / OpenRouter)
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_CHAT_PATH=/chat/completions
LLM_API_MODEL=gemini-flash-lite-latest
LLM_API_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
LLM_API_KEY=isi_api_key_di_sini
LLM_API_TIMEOUT=60
LLM_API_TEMPERATURE=0.2

# ==========================================
# Konfigurasi Embedding AI (Wadah API Embedding)
# ==========================================
# Provider embedding: 'api' (menggunakan cloud API) atau 'local' (SentenceTransformer lokal)
EMBEDDING_PROVIDER=api

# API Key Embedding: jika dikosongkan, otomatis menggunakan nilai LLM_API_KEY
EMBEDDING_API_KEY=isi_api_key_di_sini

# Endpoint Embedding API (OpenAI-compatible)
# - Contoh Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# - Contoh OpenAI: https://api.openai.com/v1
# - Contoh Ollama (Lokal API): http://localhost:11434/v1
EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_API_PATH=/embeddings

# Model Embedding AI:
# - Google Gemini: text-embedding-004 (dimensi: 768)
# - OpenAI: text-embedding-3-small (dimensi: 1536) atau text-embedding-3-large (dimensi: 3072)
EMBEDDING_API_MODEL=text-embedding-004

# Dimensi vektor embedding (768 untuk Gemini text-embedding-004, 1536 untuk text-embedding-3-small, 1024 untuk BGE-M3)
EMBEDDING_DIMENSION=768

# Timeout & Batching
EMBEDDING_API_TIMEOUT=60
EMBEDDING_BATCH_SIZE=32

# Path model lokal (hanya digunakan jika EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL_PATH=./models/bge-m3

# ==========================================
# WAHA (WhatsApp HTTP API) Gateway Config
# ==========================================
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_SESSION=default
WAHA_API_KEY=
PEKON_WHATSAPP_NUMBER=6285185222303

